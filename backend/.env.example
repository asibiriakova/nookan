# SQLAlchemy database URL. Defaults to a local SQLite file (backend/nookan.db)
# when unset, so `uv run uvicorn nookan_backend.main:app --reload` works with
# no setup. Any SQLAlchemy-supported URL works here with no code changes —
# e.g. Postgres — as long as that database's driver package is installed:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/nookan
#
# Copy this file to .env and adjust, then run with:
#   uv run --env-file .env uvicorn nookan_backend.main:app --reload
DATABASE_URL=sqlite:///./nookan.db
